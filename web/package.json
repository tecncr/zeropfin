    "e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "@alpinejs/csp": "3.17.5"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "playwright-core": "1.65.1",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
