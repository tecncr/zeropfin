{
  "name": "zeropfin-web",
  "private": true,
  "version": "0.1.0",
  "description": "Zeropfin web remote (static assets built on the developer machine/CI only)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.mjs",
